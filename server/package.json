{
  "name": "worknote-server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "description": "WorkNote 后端:解析 Markdown 记录并以 JSON API 暴露",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "init": "node ../scripts/init.mjs",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "query": "node dist/query.js",
    "record": "node dist/record.js",
    "digest": "node dist/digest.js",
    "agent": "node dist/agent.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "fastify": "^5.12.8",
    "marked": "^12.0.2",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
