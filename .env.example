# Copy to .env, then run npm run init to generate credentials.
# Paths are relative to the repository root. Keep data/ private.
WORKNOTE_ROOT=data
HOST=127.0.0.1
PORT=8000

# Generated by init when empty. Never commit real values.
WORKNOTE_PASSWORD=
WORKNOTE_SECRET=

# Default true. Set false only for local HTTP development.
WORKNOTE_SECURE_COOKIE=true
# Serve the built React app from the API process.
WORKNOTE_SERVE_CLIENT=true
# Optional comma-separated trusted reverse proxy IPs/CIDRs; default trusts none.
WORKNOTE_TRUST_PROXY=

# Optional OpenAI-compatible gateway. Base URL without trailing /v1.
# Text and images selected for AI features are sent to this provider.
WORKNOTE_AI_URL=
WORKNOTE_AI_KEY=
WORKNOTE_AI_MODEL=

# Optional notifications; work content is sent to this URL when configured.
WORKNOTE_NOTIFY_WEBHOOK=

# Explicit opt-ins for advanced Linux deployments. Leave disabled initially.
WORKNOTE_SYSTEMD=0
WORKNOTE_GIT_SNAPSHOT=0
